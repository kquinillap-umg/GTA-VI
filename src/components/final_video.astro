<section class="final">
  <div class="final-content size-full">
    <video
      id="final-video"
      muted
      playsinline
      preload="auto"
      src="/videos/car_final.mp4"
      class="size-full object-cover"></video>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.final-content', { opacity: 0 });

  gsap.timeline({
    scrollTrigger: {
      trigger: '.final',
      start: 'top top',
      end: '90% top',
      scrub: true,
      pin: true,
    },
  });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: '.final',
      start: 'top 80%',
      end: '90% top',
      scrub: true,
    },
  });

  tl.to('.final-content', { opacity: 1, duration: 1, scale: 1, ease: 'power1.inOut' });

  const video = document.querySelector<HTMLVideoElement>('#final-video');
  if (video) {
    const addTween = () => {
      tl.to(video, { currentTime: video.duration, duration: 3, ease: 'power1.inOut' }, '<');
    };
    if (video.readyState >= 1) {
      addTween();
    } else {
      video.addEventListener('loadedmetadata', addTween, { once: true });
    }
  }
</script>