<section class="post-card relative flex justify-center items-center pb-80 shadow-2xl">
  <div class="animated-gradient-bg"></div>

  <div
    class="post-card-wrapper xl:mx-56 md:mx-12 mx-5 xl:h-[85vh] md:h-[40vh] h-[30vh] w-full flex justify-center items-center overflow-hidden relative group hover:rotate-1 hover:-[1.02] transition duration-700"
  >
    <img src="/images/overlay.webp" class="absolute z-10 w-full h-full" />

    <video
      id="postcard-video"
      muted
      playsinline
      autoplay
      preload="auto"
      src="/videos/postcard.mp4"
      class="w-full h-full 2xl:scale-x-105 object-cover"
    >
    </video>

    <button
      class="text-black group-hover:bg-yellow-200 transation duration-700 rounded-full bg-white absolute left-1/2 -translate-x-1/2 md:bottom-16 -bottom-28 md:w-fit w-2/3 px-5 md:px-7 py-4 text-lg"
    >
      Explore Leonida Keys
    </button>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: '.post-card',
      start: 'top center',
      end: 'bottom center',
      scrub: true,
    },
  });

  const video = document.querySelector<HTMLVideoElement>('#postcard-video');
  if (video) {
    const addTween = () => {
      tl.to(video, { currentTime: video.duration, duration: 1, ease: 'power1.inOut' }, '<');
    };
    if (video.readyState >= 1) {
      addTween();
    } else {
      video.addEventListener('loadedmetadata', addTween, { once: true });
    }
  }
</script>
