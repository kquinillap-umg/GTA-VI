---
import Keepscroll from '/public/images/keep-scrolling.svg';
---

<Keepscroll
  class="fixed bottom-1 left-0 right-0 mx-auto text-pink-300 drop-shadow-2xl animate-bounce-pulse z-100"
/>

<style scoped>
  @import 'tailwindcss';
  @theme {
    --animate-bounce-pulse: bounce-pulse 2s ease-in-out infinite;
  }
  @keyframes bounce-pulse {
    0% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }

    50% {
      transform: translateY(-5px);
      opacity: 1;
      scale: 1;
    }

    100% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }
  }
</style>
