<section class="first-vd-wrapper">
  <div class="h-dvh">
    <video
      id="first-video"
      muted
      playsinline
      preload="auto"
      src="/videos/jason.mp4"
      class="first-vd size-full object-cover md:[object-position:50%_center] [object-position:75%_center]"
    ></video>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.first-vd-wrapper', { marginTop: '-100vh', opacity: 0 });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: '.first-vd-wrapper',
      start: 'top top',
      end: '+=200% top',
      scrub: true,
      pin: true,
    },
  });

  tl.to('.vice-city', { opacity: 0, duration: 2, ease: 'power1.inOut' });
  tl.to('.first-vd-wrapper', { opacity: 1, duration: 2, ease: 'power1.inOut' });

  const video = document.querySelector<HTMLVideoElement>('#first-video');
  if (video) {
    const addTween = () => {
      tl.to(video, { currentTime: video.duration, duration: 3, ease: 'power1.inOut' }, '<');
    };
    if (video.readyState >= 1) {
      addTween();
    } else {
      video.addEventListener('loadedmetadata', addTween, { once: true });
    }
  }
</script>