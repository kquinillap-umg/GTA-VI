<section class="vice-city w-full flex flex-col justify-center px-10 lg:px-32 gap-6">
  <h3
    class="font-sans font-bold text-5xl sm:text-6xl xl:text-7xl leading-none bg-clip-text text-transparent"
  >
    Vice City, EE. UU.
  </h3>
  <p
    class="font-sans font-bold text-lg sm:text-xl
    xl:text-2xl max-w-3xl leading-snug
    bg-clip-text text-transparent"
  >
    Jason y Lucia siempre han sabido que las cartas estaban en su contra, pero cuando un golpe que
    parecía fácil sale mal, se ven atrapados en el lado más oscuro del lugar más soleado de América,
    en medio de una conspiración criminal que se extiende por todo el estado de Leonida, y obligados
    a depender más que nunca el uno del otro si quieren salir con vida.
  </p>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.vice-city', {
    marginTop: '-60vh',
    opacity: 0,
    backgroundImage: 'linear-gradient(135deg, #a34da3, #a34da3, #a34da3)',
    webkitBackgroundClip: 'text',
    backgroundClip: 'text',
    webkitTextFillColor: 'transparent',
  });

  const coloresGradiente = {
    color1: '#a34da3',
    color2: '#a34da3',
    color3: '#a34da3',
  };

  const tl = gsap
    .timeline({
      scrollTrigger: {
        trigger: '.vice-city',
        start: 'top 100%',
        end: '10% center',
        scrub: 2,
      },
    })
    .to('.banner-hero', { opacity: 0, duration: 1, ease: 'power1.inOut' });
  tl.to('.vice-city', { opacity: 1, ease: 'power1.inOut' });
  tl.to(
    coloresGradiente,
    {
      duration: 3,
      ease: 'power1.inOut',
      color1: '#b35300',
      color2: '#fda300',
      color3: '#99004c',

      onUpdate: () => {
        gsap.set('.vice-city', {
          backgroundImage: `linear-gradient(to top, ${coloresGradiente.color1}, ${coloresGradiente.color2}, ${coloresGradiente.color3})`,
        });
      },
    },
    '<'
  );
</script>
